model Donation {
  id        String         @id @default(uuid())
  units     Int
  donatedAt DateTime
  status    DonationStatus @default(SCHEDULED)

  assignmentId String             @unique
  assignment   DonationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([donatedAt])
  @@map("donations")
}
