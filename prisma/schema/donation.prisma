model Donation {
  id        String         @id @default(uuid())
  units     Int
  scheduledAt DateTime
  donatedAt DateTime?
  status    DonationStatus @default(SCHEDULED)

  assignmentId String             @unique
  assignment   DonationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  recordUrl       String?
  recordPublicId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@map("donations")
}
