model Payment {
  id       String         @id @default(uuid())
  amount   Decimal        @db.Decimal(10, 2)
  currency String         @default("BDT")
  gateway  PaymentGateway @default(BKASH)
  status   PaymentStatus  @default(UNPAID)

  merchantInvoiceNumber String  @unique
  bkashPaymentId        String? @unique
  bkashTrxID            String?
  payerReference        String? //users email/phone
  paidAt                String?

  gatewayResponse Json?

  refundTrxId  String?
  refundAmount Decimal? @db.Decimal(10, 2)
  refundReason String?
  refundAt     String?

  requestId String       @unique
  request   BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}
